# Copy this file to .env.local for local overrides (gitignored). Every
# variable below has a safe default for local Claude Code development --
# you do not need to set anything here to run `npm run dev` as before this
# migration existed.
#
# See docs/gcp-deployment-guide.md for how these are set on the deployed
# Cloud Run service (as plain environment variables -- none of them are
# secrets under the recommended service-identity auth model).

# --- Reasoning Engine selection ---
# "claude-code" (default, local development -- requires `claude auth login`
# on this machine) or "gemini" (Vertex AI -- the Cloud Run pilot runtime).
HUBI_REASONING_PROVIDER=claude-code

# Only read when HUBI_REASONING_PROVIDER=gemini.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
HUBI_GEMINI_MODEL=gemini-2.5-flash

# --- Content Repository source ---
# "local" (default -- reads the local "Content Repository" folder, exactly
# as before this migration) or "gcs" (downloads from Cloud Storage at
# startup -- the Cloud Run pilot mode).
HUBI_CONTENT_SOURCE=local

# Only read when HUBI_CONTENT_SOURCE=gcs.
HUBI_GCS_BUCKET=
HUBI_GCS_PREFIX=

# Override the local Content Repository folder path (rarely needed).
# HUBI_CONTENT_REPOSITORY_PATH=Content Repository

# --- Cloud Run ---
# Injected automatically by Cloud Run at runtime -- do not set manually.
# PORT=8080
