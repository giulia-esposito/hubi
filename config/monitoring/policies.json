[
  {
    "displayName": "Hubi pilot: answer errors",
    "documentation": { "content": "More than 5 failed answers in 10 minutes. Logs Explorer: jsonPayload.event=\"interaction_error\". See docs/monitoring.md.", "mimeType": "text/markdown" },
    "combiner": "OR",
    "conditions": [{ "displayName": "interaction_error > 5 / 10 min", "conditionThreshold": {
      "filter": "metric.type=\"logging.googleapis.com/user/hubi_interaction_errors\" AND resource.type=\"cloud_run_revision\"",
      "aggregations": [{ "alignmentPeriod": "600s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM" }],
      "comparison": "COMPARISON_GT", "thresholdValue": 5, "duration": "0s" } }]
  },
  {
    "displayName": "Hubi pilot: model circuit open",
    "documentation": { "content": "The model provider breaker opened after repeated failures; users get 'paused' errors. Check Vertex AI status and quota.", "mimeType": "text/markdown" },
    "combiner": "OR",
    "conditions": [{ "displayName": "circuit-open >= 1", "conditionThreshold": {
      "filter": "metric.type=\"logging.googleapis.com/user/hubi_circuit_open\" AND resource.type=\"cloud_run_revision\"",
      "aggregations": [{ "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM" }],
      "comparison": "COMPARISON_GT", "thresholdValue": 0, "duration": "0s" } }]
  },
  {
    "displayName": "Hubi pilot: memory above 80%",
    "documentation": { "content": "Container memory utilization above 80% for 10 minutes. Corpus growth or a leak; limit is 2Gi (docs/production-readiness-audit-2026-11-04.md, P1-4).", "mimeType": "text/markdown" },
    "combiner": "OR",
    "conditions": [{ "displayName": "memory utilization > 0.8", "conditionThreshold": {
      "filter": "metric.type=\"run.googleapis.com/container/memory/utilizations\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"hubi-pilot\"",
      "aggregations": [{ "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_99" }],
      "comparison": "COMPARISON_GT", "thresholdValue": 0.8, "duration": "600s" } }]
  },
  {
    "displayName": "Hubi pilot: misconfigured or stale revision",
    "documentation": { "content": "A revision started with a provider other than gemini, or with a Content Registry snapshot older than 60 days.", "mimeType": "text/markdown" },
    "combiner": "OR",
    "conditions": [
      { "displayName": "wrong provider at startup", "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/hubi_wrong_provider\" AND resource.type=\"cloud_run_revision\"",
        "aggregations": [{ "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_SUM" }], "comparison": "COMPARISON_GT", "thresholdValue": 0, "duration": "0s" } },
      { "displayName": "registry snapshot older than 60 days", "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/hubi_stale_registry\" AND resource.type=\"cloud_run_revision\"",
        "aggregations": [{ "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_SUM" }], "comparison": "COMPARISON_GT", "thresholdValue": 0, "duration": "0s" } }
    ]
  }
]
